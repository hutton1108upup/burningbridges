{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "burningbridges",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "burningbridgesaivideo.pro", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
