{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "burningbridges",
  "main": "src/worker.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "7fd7ed1128ca3d125feaa279f4d4c547",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "burningbridgesaivideo.pro",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "SITE_ORIGIN": "https://burningbridgesaivideo.pro",
    "GOOGLE_LOGIN_ENABLED": "true",
    "PAYMENT_MODE": "prod",
    "GENERATION_MODE": "mock",
    "CHECKOUT_ENABLED": "true",
    "WAFFO_PRODUCTS": "{\"starter\":\"PROD_3BflwxqcmhKZOWCbEwHsB0\",\"creator\":\"PROD_1Xty8ZjFuchhmpfgFllMNY\",\"studio\":\"PROD_799kLosclEOCY5qgJhweKK\",\"pack100\":\"PROD_6riZHxKVIVNMdoPr1j5bC0\",\"pack200\":\"PROD_4YwQGoGgLOITM0MK9HIlVu\",\"pack500\":\"PROD_3Hjcv5gxfOF94UL3CHAogc\"}",
    "WAFFO_MERCHANT_ID": "MER_0Ca1DBngIQV3s35pRE1wcg",
    "WAFFO_STORE_ID": "STO_690LIDfbX77uj1xL7uZnxk"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "burningbridges-commerce-prod",
      "database_id": "f8f75279-2daf-40fd-bdd6-dd437e6788a4"
    },
    {
      "binding": "TEST_DB",
      "database_name": "burningbridges-commerce-test",
      "database_id": "b0e765e3-c9ba-4adf-9755-29c329a343e9"
    },
    {
      "binding": "PRODUCTION_DB",
      "database_name": "burningbridges-commerce-prod",
      "database_id": "f8f75279-2daf-40fd-bdd6-dd437e6788a4"
    }
  ]
}
